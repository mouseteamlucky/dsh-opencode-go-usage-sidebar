+
+.meterLabel {
+  opacity: 0.8;
+}
+
+.meterValue {
+  font-variant-numeric: tabular-nums;
+}
+
+.track {
+  height: 4px;
+  border-radius: 2px;
+  background: color-mix(in srgb, currentColor 12%, transparent);
