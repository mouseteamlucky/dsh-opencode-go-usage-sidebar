+  /** Compact three-window reading for the collapsed rail tooltip. */
+  summary: '5小时 {rolling}% · 本周 {weekly}% · 本月 {monthly}%',
+  /** Window names. */
+  rolling: '5小时窗口',
+  weekly: '本周',
+  monthly: '本月',
+  /** Meter captions. */
+  remaining: '剩余',
+  resetsIn: '后重置',
+  /** Panel chrome. */
